<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.swarmedge.parallax-league-evidence</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@RELEASE_ROOT@/scripts/collect_league_evidence.py</string>
    <string>--leagues</string><string>NBA</string>
    <string>--authorization-file</string><string>@AUTHORIZATION_FILE@</string>
    <string>--evidence-dir</string><string>@EVIDENCE_DIR@</string>
    <string>--state-dir</string><string>@STATE_DIR@</string>
    <string>--health-path</string><string>@STATE_DIR@/health.json</string>
    <string>--log-path</string><string>@STATE_DIR@/collector.log</string>
  </array>
  <key>WorkingDirectory</key><string>@RELEASE_ROOT@</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
